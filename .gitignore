# секреты — ключи API никогда не коммитятся
build/.env
*.env

# исходники, отрендеренные ролики, сток, транскрипты — личный контент, не часть шаблона
videos/*/
!videos/.gitkeep

# музыка — своя/лицензированная, не для публикации
audios/*
!audios/.gitkeep

# кэш сборки (aroll-дубли, миксы, промежуточные .mp4/.wav) — тяжёлый и легко пересобирается
build/assets/
build/**/prepared/
build/__pycache__/
build/*.pyc

# системный мусор
.DS_Store
**/.DS_Store
