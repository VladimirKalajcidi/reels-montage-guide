# секреты — ключи API никогда не коммитятся
build/.env
*.env
.env*

# медиа: исходники, рендеры, сток, звук — тяжёлые и личные (видео с лицом автора)
*.mp4
*.mov
*.m4a
*.wav
*.mp3
*.webm
videos/*/stock/
audios/*
!audios/.gitkeep

# кэш сборки — пересобирается скриптами
build/assets/
build/**/prepared/
__pycache__/
*.pyc

# веб-приложения: зависимости, рабочие данные, логи
node_modules/
webapp/jobs/
webapp/thumbs/
*.log

# системный мусор
.DS_Store
**/.DS_Store
